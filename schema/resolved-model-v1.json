{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-rebirth.local/schema/resolved-model-v1.json",
  "title": "Remote Rebirth resolved model",
  "description": "The <out>.model.json sidecar Compose writes beside the Container: every Device and Command with the IR Source that produced it, the recorded provenance and a compact IR Record summary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "skin",
    "devices",
    "activity",
    "favourites"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "skin": { "type": "integer", "minimum": 0, "maximum": 255 },
    "devices": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolved_device" }
    },
    "activity": { "$ref": "#/$defs/activity" },
    "favourites": {
      "type": "array",
      "items": { "$ref": "#/$defs/favourite" }
    }
  },
  "$defs": {
    "resolved_device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "device_key",
        "ir_group",
        "map_index",
        "commands",
        "keys"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "device_key": { "type": "integer", "minimum": 1, "maximum": 255 },
        "ir_group": { "type": "integer", "minimum": 0, "maximum": 255 },
        "map_index": { "type": "integer", "minimum": 0, "maximum": 255 },
        "commands": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/resolved_command" }
        },
        "keys": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resolved_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "provenance", "record"],
      "properties": {
        "source": { "$ref": "#/$defs/ir_source" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "record": { "$ref": "#/$defs/record_summary" }
      }
    },
    "ir_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "enum": ["pronto", "lirc", "flipper"] },
        "file": { "type": "string", "minLength": 1 },
        "hex": { "type": "string", "minLength": 1 },
        "remote": { "type": "string", "minLength": 1 },
        "button": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "selector",
        "sha256",
        "protocol",
        "sends"
      ],
      "properties": {
        "format": { "enum": ["pronto", "lirc", "flipper"] },
        "path": { "type": ["string", "null"] },
        "selector": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "protocol": { "type": "string" },
        "sends": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "record_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "index",
        "class",
        "carrier_period_ns",
        "carrier_on_ns",
        "pointer_groups",
        "blocks",
        "words"
      ],
      "properties": {
        "group": { "type": "integer", "minimum": 0, "maximum": 255 },
        "index": { "type": "integer", "minimum": 0, "maximum": 255 },
        "class": { "type": "integer", "minimum": 0, "maximum": 255 },
        "carrier_period_ns": { "type": "integer", "minimum": 0 },
        "carrier_on_ns": { "type": "integer", "minimum": 0 },
        "pointer_groups": { "type": "integer", "minimum": 0 },
        "blocks": { "type": "integer", "minimum": 0 },
        "words": { "type": "integer", "minimum": 0 }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_device", "steps"],
      "properties": {
        "channel_device": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/activity_step" }
        }
      }
    },
    "activity_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "delay_ms"],
      "properties": {
        "device": { "type": "string", "minLength": 1 },
        "power": { "type": "string", "minLength": 1 },
        "input": { "type": "string", "minLength": 1 },
        "delay_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "favourite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "channel"],
      "properties": {
        "key": { "type": "integer", "minimum": 1, "maximum": 5 },
        "channel": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,4})$" }
      }
    }
  }
}
