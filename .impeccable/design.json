  "narrative": {
    "northStar": "The Open Owner's Manual",
    "overview": "The GUI is a printed owner's manual that happens to be interactive. A cloth-bound rail holds the chapters; a single uncoated sheet carries the work; every page is set as a spread with a fixed header, a page number, and hairline rules instead of floating cards. The remote itself is explained once, as a numbered line drawing, and that drawing is the spine of the key editor. The system is calm because the task is cautious: the owner is about to erase and rewrite a device they depend on. Paper, ink, and one oxide spot carry the action; grass confirms, cobalt marks inheritance, and oxide-deep carries failure. Technical values appear only as mono marginalia, never as the page's voice.",
    "keyCharacteristics": [
      "Paper-and-cloth surfaces with a single ambient sheet shadow.",
      "One oxide action spot; success and inheritance are separate, labelled states.",
      "Numbered callouts tie the remote drawing to the work table.",
      "Serif headings, sans work text, mono codes.",
      "Flat, square controls; one 18px radius only on the schematic remote body."
    ],
    "rules": [
      {
        "name": "The One Spot Rule",
        "body": "Oxide appears only on something the owner can act on or has selected. It never decorates a neutral surface, and it never carries a state that words can carry alone.",
        "section": "colors"
      },
      {
        "name": "The Paper Ground Rule",
        "body": "Cards are not containers here. A region is paper, a rule, or a marginal note; nothing floats on a second white surface.",
        "section": "colors"
      },
      {
        "name": "The Callout Rule",
        "body": "Every key in the drawing carries a two-digit mono number in oxide; the same number opens the matching table row. The drawing and the table are one document, not two views.",
        "section": "typography"
      },
      {
        "name": "The Mono Margin Rule",
        "body": "Mono is for values, never for prose. If a sentence moves into mono, it is a code, a path, a count, or a callout.",
        "section": "typography"
      },
      {
        "name": "The One Sheet Rule",
        "body": "Only the sheet may cast a shadow. A shadow on a control means the surface has stopped being paper.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the sheet as the only shadowed surface and use 1px rules for structure.",
      "Do pair every state colour with its word: Verified, Invalid, Assigned, Inherited, Empty.",
      "Do keep the callout number on every key and the matching number in the table.",
      "Do use the serif for page and section headings and Public Sans for work text.",
      "Do use mono only for codes, paths, counts, and callouts.",
      "Do keep the configured Model opening on Buttons and the empty Model on Remote."
    ],
    "donts": [
      "Don't put controls on cards or add a second white surface.",
      "Don't add a coloured side stripe to a nav item, row, or callout.",
      "Don't use gradient text, glass, glyph icons, or emoji as iconography.",
      "Don't use blue as the action colour; oxide is the one spot.",
      "Don't round primary actions into pills; only the remote body is 18px.",
      "Don't ask the owner to type a command name where a pick list can offer the device's own commands."
    ]
  }
}