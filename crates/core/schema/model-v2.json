{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-rebirth.local/schema/model-v2.json",
  "title": "Remote Rebirth model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "skin", "devices", "activity"],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "profile": { "type": "string", "minLength": 1 },
    "skin": { "type": "integer", "minimum": 1 },
    "devices": {
      "type": "array",
      "description": "8 is the family-wide ceiling; the active Model Profile may allow fewer (Harmony 300: 4).",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/device" }
    },
    "routing": { "$ref": "#/$defs/routing" },
    "activity": { "$ref": "#/$defs/activity" },
    "favourites": {
      "type": "array",
      "items": { "$ref": "#/$defs/favourite" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": 1 } },
        "required": ["schema_version"]
      },
      "then": { "not": { "required": ["routing"] } }
    }
  ],
  "$defs": {
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "volume": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "device_key", "commands"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "device_key": { "type": "integer", "minimum": 1, "maximum": 8 },
        "commands": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/command" }
        },
        "keys": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "$ref": "#/$defs/ir_source" },
        "sends": { "type": "integer", "minimum": 1 }
      }
    },
    "ir_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "enum": ["pronto", "lirc", "flipper"] },
        "file": { "type": "string", "minLength": 1 },
        "hex": { "type": "string", "minLength": 1 },
        "remote": { "type": "string", "minLength": 1 },
        "button": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "format": { "const": "pronto" } }, "required": ["format"] },
          "then": { "oneOf": [{ "required": ["hex"] }, { "required": ["file"] }] }
        },
        {
          "if": { "properties": { "format": { "const": "lirc" } }, "required": ["format"] },
          "then": {
            "required": ["file", "remote", "button"],
            "not": { "required": ["hex"] }
          }
        },
        {
          "if": { "properties": { "format": { "const": "flipper" } }, "required": ["format"] },
          "then": {
            "required": ["file", "command"],
            "not": { "required": ["hex"] }
          }
        }
      ]
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_device", "steps"],
      "properties": {
        "channel_device": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/activity_step" }
        }
      }
    },
    "activity_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device"],
      "properties": {
        "device": { "type": "string", "minLength": 1 },
        "power": { "type": "string", "minLength": 1 },
        "input": { "type": "string", "minLength": 1 },
        "delay_ms": {
          "type": "integer",
          "description": "Compose rounds up to 100 ms steps and clamps to 1-255 tenths of a second (0.1-25.5 s).",
          "minimum": 0,
          "default": 500
        }
      },
      "anyOf": [{ "required": ["power"] }, { "required": ["input"] }]
    },
    "favourite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "channel"],
      "properties": {
        "key": { "type": "integer", "minimum": 1, "maximum": 5 },
        "channel": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,4})$" }
      }
    }
  }
}
